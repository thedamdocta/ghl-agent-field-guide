# Copy to .env and fill in. NEVER commit .env — it holds live credentials.
#
#   cp .env.example .env
#
# Every tool here reads credentials from the environment first and this file
# second, so `export GHL_PIT=...` also works and takes precedence.

# ── Public API (services.leadconnectorhq.com, incl. the MCP server) ──────────
# Private Integration Token. Create it in the SUB-ACCOUNT:
#   Settings -> Private Integrations -> Create new integration
# Scope it to only what you need. It is a live credential.
# Used by: ghl_mcp.py
GHL_PIT=pit-00000000-0000-0000-0000-000000000000

# The sub-account (location) id. It is the 20-character id in your GHL URL:
#   app.gohighlevel.com/v2/location/<THIS_PART>/dashboard
# Used by: ghl_mcp.py, get_token.py, deploy_workflow.py
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxx

# ── Internal API (backend.leadconnectorhq.com) ───────────────────────────────
# The internal token-id is NOT stored here. It is short-lived (~1h) and is
# captured on demand by get_token.py, which writes it to the file below.
# The PIT does NOT work against the internal API — do not try.

# Where get_token.py writes the captured token-id, and where inject_page.py and
# deploy_workflow.py read it from. Keep it gitignored.
GHL_TOKEN_FILE=.jwt

# Chrome remote-debugging port that get_token.py attaches to. You must launch
# Chrome yourself with --remote-debugging-port=<this> on a dedicated
# --user-data-dir, and log in to GHL by hand once.
GHL_CDP_PORT=9222

# Optional: pass an already-known token-id instead of using the file.
# Overridden by --token on the command line.
# GHL_TOKEN_ID=eyJ...
